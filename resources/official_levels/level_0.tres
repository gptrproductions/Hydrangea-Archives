[sub_resource type="Resource" id="Resource_mxjfn"]
script = ExtResource("2_lumh0")
question_title = "If the world was ending, WHAT NOW!?"
question_text = "I don't know either, but Lady Gaga and Bruno Mars preferred that they be..."
choices = Array[Array]([["Embalmed by aliens", false], ["Next to each other", true], ["Spontaneously detonated", false], ["With their families", false], ["Talking about their memories", false]])
chances = 2
required_answers = 2
trivia_text = "This question is a reference to the Chorus of Die With A Smile, a Duet between Lady Gaga and Bruno Mars."
wrong_text = "You realize three of the five questions are utterly ridiculous, right? Bruno and Gaga may have crazy lines, but they're not THAT crazy. "
metadata/_custom_type_script = "uid://b4brsw3v3g6ew"

[sub_resource type="Resource" id="Resource_squa6"]
script = ExtResource("2_lumh0")
subject = 5
question_title = "FULL, THROTTLE, FULL THRUST (O.O)"
question_text = "In Phineas and Ferb 5x02B, Candace obtained a license. What license is it?"
choices = Array[Array]([["A License to Bust", false], ["A Driver's License", true], ["A Teacher's License", false]])
hint_text = "It's not title of the episode... or another valid answer."
trivia_text = "It's her Driver's License. She already had the 'license' to bust a long time ago-- just metaphorically acknowledged it now. "
wrong_text = "I'm pretty sure she had the license to bust ever since Jeremy happened."
metadata/_custom_type_script = "uid://b4brsw3v3g6ew"

