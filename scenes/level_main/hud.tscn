uniform float scale = 1.0;
uniform float wave_amplitude : hint_range(0.0, 0.1) = 0.02;
uniform float wave_frequency : hint_range(0.0, 10.0) = 3.0;
uniform float wave_speed : hint_range(0.0, 5.0) = 1.5;

mediump float wave_func(vec2 uv) {
    return wave_amplitude * sin(wave_frequency * uv.y + TIME * wave_speed);
}

void fragment() {
    vec2 uv = UV;

    // **Optimize scrolling gradient calculation**
    float offset = mod(TIME * speed, 1.0);
    float shifted_u = mod(UV.x * scale + offset, 1.0);
    
    // **Apply liquid wave effect**
    float wave_offset = wave_func(UV);
    float wave_progress = progress + wave_offset;

    // **Texture samples optimized**
    vec4 grad_color = texture(gradient_texture, vec2(shifted_u, 0.0));
    vec4 bevel_color = texture(bevel_texture, UV);
    float mask = texture(mask_texture, UV).r;

    // **Skip expensive per-pixel loops and optimize particles**
    vec4 final_color = background_color;
    if (UV.x < wave_progress) {
        final_color = mix(background_color, grad_color, mask);
    }

    // **Blend bevel overlay efficiently**
    final_color += bevel_color;

    // **Final optimized output**
    COLOR = final_color;
}
"

